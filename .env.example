# Optional. If set, this protects dashboard control endpoints. Never publish this value.
ADMIN_TOKEN=
# VPS only: exact HTTPS domain behind the included Caddy reverse proxy.
# Leave blank for localhost-only use. If set, ADMIN_TOKEN must be at least 32 random characters.
PUBLIC_ORIGIN=
# Optional. To receive Telegram alerts, create a bot with BotFather and configure both values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Keep this on loopback. Remote network binding is intentionally unsupported.
HOST=127.0.0.1
PORT=8787
# New crypto liquidity-pool scan controls. This does not scan forex/USDJPY.
SCAN_INTERVAL_MS=15000
PRICE_INTERVAL_MS=15000
# GeckoTerminal new-pool discovery is independently throttled to reduce HTTP 429 responses.
GECKO_SCAN_INTERVAL_MS=60000
# Scanner limits. Entries are only considered on pools no older than 15 minutes.
MIN_LIQUIDITY_USD=12000
MIN_MOONSHOT_SCORE=78
MAX_MARKET_CAP_USD=2000000
MAX_ENTRY_AGE_MINUTES=15
MIN_BUY_FLOW_5M=0.58
MAX_PRICE_IMPULSE_5M_PCT=35
MAX_OPEN_TRADES=2
POSITION_SIZE_PCT=5
MAX_DRAWDOWN_PCT=8
ENTRY_STOP_PCT=18
TRAILING_START_X=1.5
TRAILING_DRAWDOWN_PCT=22
LIQUIDITY_CRASH_PCT=45
REQUIRE_SECURITY_CHECK=true
